# Dockerfile for publishing lks-idprovider-api
#
# Expects a `dist/` directory (already built, e.g. by the main Dockerfile's
# `builder` target) in the build context alongside this package's pyproject.toml.
# This package is published to public PyPI (not an internal registry).

# Use a minimal base image
FROM python:3.11-slim

# Install uv
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy the built package from the context
COPY dist/ /app/dist/

# Copy the pyproject.toml (uv reads project name/version from it when publishing)
COPY pyproject.toml ./

# PyPI API token, to be passed as a build argument
ARG PYPI_API_TOKEN

# Publish the package to PyPI (no --publish-url: uv defaults to the real PyPI)
# Note: storing credentials in the environment is not recommended for production.
# Jenkins should handle credential injection securely.
RUN uv publish --token "$PYPI_API_TOKEN" dist/*
